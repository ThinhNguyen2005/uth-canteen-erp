flowchart TD
    A([Start: Identify replenishment need]) --> B[Create Request for Quotation]
    B --> C[Select supplier and products]
    C --> D[Review quotation, quantity, price and delivery]
    D --> E{RFQ approved?}
    E -- No --> F[Revise or cancel RFQ]
    F --> B
    E -- Yes --> G[Confirm Purchase Order]
    G --> H[Odoo creates incoming receipt]
    H --> I[Inspect delivered goods]
    I --> J[Record accepted and rejected quantities]
    J --> K[Validate receipt for physically received goods]
    K --> L{Remaining ordered quantity?}
    L -- Yes --> M{Expected to arrive later?}
    M -- Yes --> N[Create backorder]
    M -- No --> O[Cancel remaining quantity]
    L -- No --> P[No backorder required]
    N --> Q{Rejected or damaged goods?}
    O --> Q
    P --> Q
    Q -- Yes --> R[Create return from validated receipt]
    R --> S[Validate outgoing return]
    S --> T[Follow up replacement or refund]
    Q -- No --> U[No return required]
    T --> V[Verify updated on-hand stock]
    U --> V
    V --> W{Physical count discrepancy?}
    W -- Yes --> X[Investigate and perform approved inventory adjustment]
    W -- No --> Y([Complete])
    X --> Y
