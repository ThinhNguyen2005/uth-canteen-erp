<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_canteen_meal_slot_list" model="ir.ui.view">
        <field name="name">canteen.meal.slot.list</field>
        <field name="model">canteen.meal.slot</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'full'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="start_at"/>
                <field name="end_at"/>
                <field name="capacity"/>
                <field name="booked_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_canteen_meal_slot_form" model="ir.ui.view">
        <field name="name">canteen.meal.slot.form</field>
        <field name="model">canteen.meal.slot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_slot" type="object" string="Open Slot"
                            groups="canteen_management.group_canteen_manager"
                            invisible="state != 'draft' or not active or capacity &lt;= 0"/>
                    <button name="action_close_slot" type="object" string="Close Slot"
                            groups="canteen_management.group_canteen_manager"
                            invisible="state not in ['open', 'full']"/>
                    <field name="state" widget="statusbar" readonly="1"
                           statusbar_visible="draft,open,full,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="start_at"/>
                            <field name="end_at"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="booked_count" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_canteen_meal_slot_search" model="ir.ui.view">
        <field name="name">canteen.meal.slot.search</field>
        <field name="model">canteen.meal.slot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <filter name="start_date" string="Start Date" date="start_at"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="full" string="Full" domain="[('state', '=', 'full')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"
                        context="{'active_test': False}"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_day" string="Start Day" context="{'group_by': 'start_at:day'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
