<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_canteen_meal_booking_list" model="ir.ui.view">
        <field name="name">canteen.meal.booking.list</field>
        <field name="model">canteen.meal.booking</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'served'">
                <field name="booking_ref"/>
                <field name="partner_id"/>
                <field name="slot_id"/>
                <field name="quantity"/>
                <field name="booked_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_canteen_meal_booking_form" model="ir.ui.view">
        <field name="name">canteen.meal.booking.form</field>
        <field name="model">canteen.meal.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_booking" type="object" string="Confirm" groups="canteen_management.group_canteen_manager" invisible="state != 'draft'"/>
                    <button name="action_cancel_booking" type="object" string="Cancel" groups="canteen_management.group_canteen_manager" invisible="state not in ['draft', 'confirmed']"/>
                    <button name="action_mark_booking_served" type="object" string="Serve" groups="canteen_management.group_canteen_cashier,canteen_management.group_canteen_manager" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <field name="booking_ref"/>
                        <field name="partner_id" readonly="state != 'draft' and id"/>
                        <field name="slot_id" readonly="state != 'draft' and id"/>
                        <field name="quantity" readonly="state != 'draft' and id"/>
                        <field name="booked_at"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_canteen_meal_booking_search" model="ir.ui.view">
        <field name="name">canteen.meal.booking.search</field>
        <field name="model">canteen.meal.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="booking_ref"/>
                <field name="partner_id"/>
                <field name="slot_id"/>
                <filter name="date_booked" string="Booking Date" date="booked_at"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="served" string="Served" domain="[('state', '=', 'served')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter name="group_slot" string="Meal Slot" context="{'group_by': 'slot_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
