<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Meal Booking Reference (docs/data-contract.md Section 3.5) -->
        <record id="seq_canteen_meal_booking" model="ir.sequence">
            <field name="name">Canteen Meal Booking Sequence</field>
            <field name="code">canteen.meal.booking</field>
            <field name="prefix">BKG-%(year)s%(month)s%(day)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
